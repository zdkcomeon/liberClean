{
  "name": "mole-console",
  "version": "0.1.0",
  "description": "在 uTools 中查看 Mac 状态、分析磁盘并执行 Mole 维护操作",
  "author": "Mole Console",
  "homepage": "https://github.com/tw93/Mole",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "pluginSetting": {
    "single": true,
    "height": 600
  },
  "development": {
    "main": "http://127.0.0.1:5174"
  },
  "features": [
    {
      "code": "mole-overview",
      "platform": "darwin",
      "description": "打开 Mole 本机控制台",
      "cmds": [
        "Mole",
        "Mole 控制台",
        "mo",
        "Mole Web"
      ]
    },
    {
      "code": "mole-analyze",
      "platform": "darwin",
      "description": "分析目录与磁盘占用",
      "cmds": [
        "Mole 磁盘分析",
        "磁盘占用分析"
      ]
    },
    {
      "code": "mole-clean",
      "platform": "darwin",
      "description": "预览或执行深度清理",
      "cmds": [
        "Mole 深度清理",
        "Mole 清理"
      ]
    },
    {
      "code": "mole-uninstall",
      "platform": "darwin",
      "description": "选择应用并检查关联文件后卸载",
      "cmds": [
        "Mole 应用卸载",
        "Mole 卸载"
      ]
    },
    {
      "code": "mole-optimize",
      "platform": "darwin",
      "description": "刷新缓存并执行系统优化",
      "cmds": [
        "Mole 系统优化",
        "Mole 优化"
      ]
    },
    {
      "code": "mole-purge",
      "platform": "darwin",
      "description": "清理旧项目的依赖与构建产物",
      "cmds": [
        "Mole 项目清理",
        "Mole 开发缓存"
      ]
    },
    {
      "code": "mole-installer",
      "platform": "darwin",
      "description": "查找并移除安装包",
      "cmds": [
        "Mole 安装包清理",
        "Mole 安装包"
      ]
    },
    {
      "code": "mole-history",
      "platform": "darwin",
      "description": "查看 Mole 操作记录",
      "cmds": [
        "Mole 历史",
        "Mole 操作记录"
      ]
    }
  ]
}
